# Copia este archivo a .streamlit/secrets.toml y completa las credenciales.
# NUNCA subas secrets.toml a git (ya esta en .gitignore).
#
# OPCION A (recomendada, y la que ya esta activa en tu secrets.toml real):
# reutilizar tus credenciales OAuth existentes (secret.json + gsheets_token.json
# que ya tenias en D:\Otros proyectos\nutrienti). Esto autentica la app como
# TU cuenta de Google, que ya es dueña de las 3 hojas, asi que no hace falta
# compartir nada con nadie. Util porque tu organizacion bloquea la creacion
# de llaves de cuenta de servicio (politica iam.disableServiceAccountKeyCreation).
[gcp_oauth]
client_id = "tu-client-id.apps.googleusercontent.com"
client_secret = "tu-client-secret"
refresh_token = "tu-refresh-token"
token_uri = "https://oauth2.googleapis.com/token"

# OPCION B (alternativa, si en algun momento tu organizacion habilita la
# creacion de llaves de cuenta de servicio): usar una cuenta de servicio
# clasica. En ese caso hay que compartir las 3 hojas con el "client_email"
# de la cuenta de servicio (Lector para clientes/productos, Editor para la
# hoja de pedidos), y comentar/eliminar la seccion [gcp_oauth] de arriba.
# [gcp_service_account]
# type = "service_account"
# project_id = "your-project-id"
# private_key_id = "your-private-key-id"
# private_key = "-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
# client_email = "your-service-account@your-project-id.iam.gserviceaccount.com"
# client_id = "your-client-id"
# auth_uri = "https://accounts.google.com/o/oauth2/auth"
# token_uri = "https://oauth2.googleapis.com/token"
# auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
# client_x509_cert_url = "your-cert-url"
